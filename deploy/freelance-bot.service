[Unit]
Description=Freelance Search Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/freelance_search
EnvironmentFile=/home/ubuntu/freelance_search/.env
ExecStart=/home/ubuntu/freelance_search/.venv/bin/python -m bot.run_bot
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/freelance_search/bot.log
StandardError=append:/home/ubuntu/freelance_search/bot.log

[Install]
WantedBy=multi-user.target
